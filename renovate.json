{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["* * * * 5"],
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null
  },
  "automerge": true,
  "platformAutomerge": true,
  "configMigration": true,
  "packageRules": [
    {
      "description": "Major updates need a human review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "gitIgnoredAuthors": [
    "346494549+container-tools-automation[bot]@users.noreply.github.com"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "libseccomp release in the setup action; LIBSECCOMP_SHA256 follows via hack/update-checksums.sh",
      "managerFilePatterns": ["/^\\.github/actions/setup/action\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+LIBSECCOMP_VERSION: (?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "systemd tag in the setup action, with the tag's commit as digest",
      "managerFilePatterns": ["/^\\.github/actions/setup/action\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+SYSTEMD_VERSION: (?<currentValue>\\S+)\\s+SYSTEMD_COMMIT: (?<currentDigest>[0-9a-f]{40})"
      ]
    }
  ]
}
