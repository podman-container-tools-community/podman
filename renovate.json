{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "libseccomp release in the setup action; LIBSECCOMP_SHA256 has to be updated by hand",
      "managerFilePatterns": ["/^\\.github/actions/setup/action\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+LIBSECCOMP_VERSION: (?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
