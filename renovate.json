{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["* * * * 5"],
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null
  },
  "automerge": true,
  "platformAutomerge": true,
  "configMigration": true,
  "packageRules": [
    {
      "description": "Major updates need a human review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "libseccomp release in the setup action, with the sha256 of its tarball as digest",
      "managerFilePatterns": ["/^\\.github/actions/setup/action\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+LIBSECCOMP_VERSION: (?<currentValue>\\S+)\\s+LIBSECCOMP_SHA256: (?<currentDigest>[0-9a-f]{64})"
      ]
    },
    {
      "customType": "regex",
      "description": "systemd tag in the setup action, with the tag's commit as digest",
      "managerFilePatterns": ["/^\\.github/actions/setup/action\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+SYSTEMD_VERSION: (?<currentValue>\\S+)\\s+SYSTEMD_COMMIT: (?<currentDigest>[0-9a-f]{40})"
      ]
    }
  ]
}
